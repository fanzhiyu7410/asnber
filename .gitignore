# .gitignore：CMake 构建产物、IDE、平台产物与临时文件

# ---------------------------------------------------------------------------
# CMake
# ---------------------------------------------------------------------------
# 构建目录只锚定仓库根，并限定 build/、build-<name>/、build_<name>/ 形式：
# 不放过根下的 build-cms-env 这类目录，也不会误伤 buildings/ 等同前缀目录。
# 模块内 in-source 构建不在本规则内：出现时 git status 会显示未跟踪产物，
# 应清理产物，而不是放宽为任意深度的 build*。
/build/
/build-*/
/build_*/
/cmake-build-*/
out/
install*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/
CMakeUserPresets.json
*.ninja
.ninja_deps
.ninja_log
# 只忽略仓库根的 CMake 生成 Makefile；子目录里手写的 Makefile 仍可提交。
/Makefile
!cmake/*.cmake

# ---------------------------------------------------------------------------
# 编译/链接产物与调试信息
# ---------------------------------------------------------------------------
# 后缀规则保留且不做路径锚定：受版本控制的资产使用 .der/.json/.asn1/.txt
# 等后缀，与下列构建产物后缀无交集；子目录里的构建产物同样需要被忽略。
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.exp
*.map
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# ---------------------------------------------------------------------------
# IDE：Visual Studio / CLion / VSCode / Xcode / Eclipse
# ---------------------------------------------------------------------------
.vs/
.idea/
.vscode/
*.sln
*.suo
*.user
*.userosscache
*.filters
*.vcxproj
*.vcxproj.*
*.ipch
*.xcodeproj/
xcuserdata/
DerivedData/
.cproject
.project
.settings/
*.launch

# ---------------------------------------------------------------------------
# 工具临时目录
# ---------------------------------------------------------------------------
.screenshots/
# 工具过程目录（各轮 spec/tasks 草稿）；需长期保留的结论应汇总进 docs/
.trae/
# 本地临时实验目录（探针、变异/往返样本等一次性残留，如 .tmp-auth/）
.tmp-*/

# ---------------------------------------------------------------------------
# 操作系统与临时文件
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log
*.swp
*.swo
*~
.\#*

# ---------------------------------------------------------------------------
# 覆盖率与测试输出
# ---------------------------------------------------------------------------
coverage/
# llvm-profdata / llvm-cov 输出目录（docs/07 §5.1 的 cov/）
cov/
htmlcov/
*.lcov
*.info
test-results/
junit*.xml

# ---------------------------------------------------------------------------
# 模糊测试临时产物
# ---------------------------------------------------------------------------
crash-*
leak-*
timeout-*
oom-*
fuzz-*.log
fuzz-*.profraw

# ---------------------------------------------------------------------------
# 脚本环境
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
